# /etc/atelier/env — root:h3studio 0640
PUBLIC_ORIGIN=https://atelier.example.com:8444
PORT=18790
DATA_DIR=/opt/services/atelier-data
TOKEN_PEPPER=<openssl rand -hex 32>
NODE_BINARY=/opt/services/node-current/bin/node
COMFY_URL=http://127.0.0.1:19188
COMFY_CLIENT_ID=h3studio
# CompShare (UCloud) — enables auto power on/off + cost meter
COMPSHARE_PUBLIC_KEY=
COMPSHARE_PRIVATE_KEY=
COMPSHARE_INSTANCE_ID=uhost-xxxxxxxxxxxx
COMPSHARE_REGION=cn-wlcb
COMPSHARE_ZONE=cn-wlcb-01
GPU_HOURLY_RATE=3.32
GPU_IDLE_MINUTES=10
# fileshare on the same box — share links
FILESHARE_URL=http://127.0.0.1:8787
FILESHARE_TOKEN=
# prompt assistant (OpenAI-compatible)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
PROMPT_RULES_URL=https://atelier.example.com/h3.md
SUBTITLE_FONT=Noto Sans CJK SC

# 车队隧道（Hysteria2）：13 在洛杉矶、GPU 在大陆，普通 TCP 进大陆每流约 24 KB/s，
# 同一条路径走 QUIC + 无视丢包的拥塞控制实测 6 MB/s。服务端配置在 /etc/atelier/hy2-fleet.yaml。
FLEET_HY2_SERVER=atelier.example.com:7100
FLEET_HY2_PASSWORD=
